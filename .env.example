# Aether local development defaults.
# Copy to .env only when local overrides are needed.

AETHER_ENVIRONMENT=local
AETHER_LOG_LEVEL=INFO
AETHER_API_HOST=0.0.0.0
AETHER_API_PORT=18000
AETHER_API_PREFIX=
AETHER_DOCS_ENABLED=true

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether_dev_password
POSTGRES_PORT=5432

REDIS_IMAGE=redis:7.4-alpine
REDIS_PORT=6379

QDRANT_IMAGE=qdrant/qdrant:v1.15.3
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
