# Aether local development configuration template.
# Copy this file to .env and replace every value marked CHANGE_ME.
# These settings are for an isolated workstation only, never production.

AETHER_ENVIRONMENT=local
AETHER_LOG_LEVEL=INFO
AETHER_API_HOST=127.0.0.1
AETHER_API_PORT=18000
AETHER_API_PREFIX=
AETHER_DOCS_ENABLED=true

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=CHANGE_ME_USE_A_UNIQUE_LOCAL_PASSWORD
POSTGRES_PORT=5432

REDIS_IMAGE=redis:7.4-alpine
REDIS_PORT=6379

QDRANT_IMAGE=qdrant/qdrant:v1.15.3
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
